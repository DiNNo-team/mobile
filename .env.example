# Origen del backend, sin /v1 y sin "/" final. Deja UNA sola línea activa.
# Después de cambiarla, reinicia Expo con `npx expo start -c` para que la tome.

# Backend desplegado en Render (por defecto): funciona desde cualquier red.
EXPO_PUBLIC_API_URL=https://dinno-backend.onrender.com

# Backend local en tu computador (comenta la línea de arriba y descomenta esta).
# En el celular NO uses localhost: usa la IP de tu PC (ipconfig -> IPv4), con el celular
# en la misma red wifi y el puerto 3000 permitido en el firewall de Windows.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
