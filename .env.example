# Copia este archivo a .env (cp .env.example .env) y completa los valores.
# Después de cambiar .env, reinicia Expo con `npx expo start -c` para que la app los tome.
# Las variables EXPO_PUBLIC_* quedan DENTRO de la app: nunca pongas secretos en ellas.

# Origen del backend, sin /v1 y sin "/" final. Deja UNA sola línea activa.
# Backend desplegado en Render (por defecto): funciona desde cualquier red.
EXPO_PUBLIC_API_URL=https://dinno-backend.onrender.com
# Backend local desde el EMULADOR de Android: 10.0.2.2 es tu computador visto desde el emulador.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# "true" usa los datos de ejemplo en memoria (forma exacta del contrato de CLAUDE.md §10) y no llama al backend.
# Sirve para trabajar las pantallas mientras llegan los endpoints. Cualquier otro valor usa el backend.
EXPO_PUBLIC_USE_MOCKS=false

# Solo con el backend LOCAL y DEV_USER_ENABLED=true en el backend: UUID de un usuario de la tabla users
# (por ejemplo, el comensal de prueba que imprime `npm run seed`). Se envía como x-dev-user-id cuando
# no hay sesión de Firebase. En el ambiente desplegado el backend lo ignora. Déjalo vacío si no lo usas.
EXPO_PUBLIC_DEV_USER_ID=

# Configuración pública de Firebase Authentication (la misma de la web: VITE_FIREBASE_*). No son secretos.
# Consola de Firebase → ⚙️ Project settings → General → Your apps → app Web → Config.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# ID de cliente WEB de OAuth del proyecto de Firebase (público, no es secreto), para «Continuar con Google».
# Consola de Firebase → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
# (o Google Cloud → APIs y servicios → Credenciales → «Web client (auto created by Google Service)»).
# Además debe existir un cliente OAuth de ANDROID con com.dinno.app + el SHA-1 del README (no va en .env).
# Sin este valor, el botón muestra un error y el resto de la app funciona.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Llave de Android de Google Maps (Maps SDK for Android). La entrega el equipo de Google Cloud por un canal
# privado. NO lleva EXPO_PUBLIC_: la lee app.config.ts al compilar y va a la configuración nativa, no al JavaScript.
# Restringida al paquete com.dinno.app + SHA-1 del README. Sin ella la app funciona, pero solo con la lista.
# Después de ponerla o cambiarla: npx expo prebuild --clean && npx expo run:android
GOOGLE_MAPS_ANDROID_API_KEY=
